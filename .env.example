# Environment variables for the Cinema Management System
# These are used for development and testing purposes

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Database Configuration (Container)
DB_HOST=
DB_PORT=
DB_NAME=$POSTGRES_DB
DB_USER=$POSTGRES_USER
DB_PASS=$POSTGRES_PASSWORD
DB_SSL=

# Test Database Configuration (Container)
TEST_DB_HOST=
TEST_DB_PORT=
TEST_DB_NAME=
TEST_DB_USER=$POSTGRES_USER
TEST_DB_PASS=$POSTGRES_PASSWORD
TEST_DB_SSL=
TEST_DATABASE_URL=

# JWT Configuration
JWT_SECRET=
TOKEN_DURATION=

# SMTP Configuration for Email 2FA
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# Server Configuration
ADDR=

# Observability / Tracing
OTEL_TRACES_ENABLED=false
OTEL_METRICS_ENABLED=false
OTEL_EXPORTER=stdout
OTEL_EXPORTER_STDOUT_PATH=artifacts/observability/traces.jsonl
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_RATIO=1.0
OTEL_SERVICE_NAME=cinema-api
OTEL_ENVIRONMENT=development

# Logging
LOG_MODE=default
LOG_LEVEL=error
LOG_OUTPUT=
LOG_TIMESTAMP=true
