# Test Database Configuration (Container)
TEST_DB_HOST=
TEST_DB_PORT=
TEST_DB_NAME=
TEST_DB_USER=$POSTGRES_USER
TEST_DB_PASS=$POSTGRES_PASSWORD
TEST_DB_SSL=
TEST_DATABASE_URL=

# JWT Configuration
JWT_SECRET=
TOKEN_DURATION=

# SMTP Configuration for Email 2FA
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# Server Configuration
ADDR=